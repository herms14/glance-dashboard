# Copy to /opt/glance/.env on the Glance host (chmod 600). Glance substitutes
# ${VAR} references in glance.yml at startup and fails if a referenced variable is unset.

# Proxmox API token used by the Compute/Storage widgets, format: user@realm!tokenid=secret
# A read-only token (PVEAuditor role) is enough.
PROXMOX_API_TOKEN=glance@pve!dashboard=00000000-0000-0000-0000-000000000000

# Arr stack (Settings > General > API Key in each app)
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Must match UPDATE_API_KEY of service-version-api (used by the "Update" buttons on the Services page)
SERVICE_VERSION_API_KEY=
