# Copy to /opt/glance/.env on the Glance host (chmod 600). Glance substitutes
# ${VAR} references in config/ at startup and fails if a referenced variable is unset.

# Proxmox API auth header value for the Compute/Storage widgets: PVEAPIToken=CHANGE_ME
# A read-only token (PVEAuditor role) is enough.
GLANCE_PVE_AUTH=PVEAPIToken=glance@pve!dashboard=CHANGE_ME

# Arr stack (Settings > General > API Key in each app)
GLANCE_RADARR_KEY=
GLANCE_SONARR_KEY=
GLANCE_PROWLARR_KEY=

# Must match the Lab Feed token on the Roundtable host (sent as X-Labfeed-Token)
LABFEED_TOKEN=

# Technitium DNS (Network page): API token of a read-only user (Dashboard view only)
GLANCE_TECHNITIUM_TOKEN=
